
import cv2
import numpy as np
import matplotlib.pyplot as plt
import colorsys

# Membaca gambar
img = cv2.imread('gambar.jpg')

if img is None:
    print("Gambar tidak ditemukan!")
    exit()

# Mengubah BGR menjadi RGB secara manual
rgb = img[:, :, ::-1]

tinggi, lebar, _ = rgb.shape

# Menyiapkan gambar hasil konversi
cmyk = np.zeros((tinggi, lebar, 3), dtype=np.uint8)
hsi = np.zeros((tinggi, lebar, 3), dtype=np.uint8)
hsv = np.zeros((tinggi, lebar, 3), dtype=np.uint8)

# 1. Konversi RGB ke CMYK
for y in range(tinggi):
    for x in range(lebar):
        r, g, b = rgb[y, x] / 255.0

        k = 1 - max(r, g, b)

        if k == 1:
            c, m, yy = 0, 0, 0
        else:
            c = (1 - r - k) / (1 - k)
            m = (1 - g - k) / (1 - k)
            yy = (1 - b - k) / (1 - k)

        cmyk[y, x] = [
            int(c * 255),
            int(m * 255),
            int(yy * 255)
        ]


# 2. Konversi RGB ke HSI
for y in range(tinggi):
    for x in range(lebar):
        r, g, b = rgb[y, x] / 255.0

        total = r + g + b

        if total == 0:
            h, s, intensity = 0, 0, 0
        else:
            intensity = total / 3

            minimum = min(r, g, b)

            s = 1 - (3 * minimum / total)

            pembilang = 0.5 * ((r - g) + (r - b))
            penyebut = np.sqrt((r - g)**2 + (r - b)*(g - b))

            if penyebut == 0:
                h = 0
            else:
                theta = np.arccos(
                    np.clip(pembilang / penyebut, -1, 1)
                )

                if b <= g:
                    h = theta
                else:
                    h = 2 * np.pi - theta

            h = h * 180 / np.pi

        hsi[y, x] = [
            int(h * 255 / 360),
            int(s * 255),
            int(intensity * 255)
        ]


# 3. Konversi RGB ke HSV
for y in range(tinggi):
    for x in range(lebar):
        r, g, b = rgb[y, x] / 255.0

        maksimum = max(r, g, b)
        minimum = min(r, g, b)
        delta = maksimum - minimum

        v = maksimum

        if maksimum == 0:
            s = 0
        else:
            s = delta / maksimum

        if delta == 0:
            h = 0
        elif maksimum == r:
            h = 60 * (((g - b) / delta) % 6)
        elif maksimum == g:
            h = 60 * (((b - r) / delta) + 2)
        else:
            h = 60 * (((r - g) / delta) + 4)

        hsv[y, x] = [
            int(h * 255 / 360),
            int(s * 255),
            int(v * 255)
        ]


# 4. Menampilkan hasil
images = [
    rgb,
    cmyk,
    hsi,
    hsv
]

titles = [
    'RGB',
    'CMY (CMYK)',
    'HSI',
    'HSV'
]

plt.figure(figsize=(12, 8))

for i in range(len(images)):
    plt.subplot(2, 2, i + 1)
    plt.imshow(images[i])
    plt.title(titles[i])
    plt.axis('off')

plt.tight_layout()
plt.show()
