
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Membaca gambar
img = cv2.imread('gambar.jpg', cv2.IMREAD_GRAYSCALE)

if img is None:
    print("Gambar tidak ditemukan!")
    exit()

# 1. Mean Filter
mean_filter = np.zeros(img.shape, dtype=np.uint8)
tinggi, lebar = img.shape

for y in range(1, tinggi - 1):
    for x in range(1, lebar - 1):
        total = 0

        for i in range(-1, 2):
            for j in range(-1, 2):
                total += int(img[y + i, x + j])

        mean_filter[y, x] = total // 9


# 2. Median Filter
median_filter = np.zeros(img.shape, dtype=np.uint8)

for y in range(1, tinggi - 1):
    for x in range(1, lebar - 1):
        nilai = []

        for i in range(-1, 2):
            for j in range(-1, 2):
                nilai.append(int(img[y + i, x + j]))

        nilai.sort()
        median_filter[y, x] = nilai[4]


# 3. Gaussian Filter
gaussian_filter = np.zeros(img.shape, dtype=np.uint8)

kernel = [
    [1, 2, 1],
    [2, 4, 2],
    [1, 2, 1]
]

for y in range(1, tinggi - 1):
    for x in range(1, lebar - 1):
        total = 0

        for i in range(-1, 2):
            for j in range(-1, 2):
                total += int(img[y + i, x + j]) * kernel[i + 1][j + 1]

        gaussian_filter[y, x] = total // 16


# 4. Laplacian Filter
laplacian = np.zeros(img.shape, dtype=np.uint8)

kernel_lap = [
    [0, -1, 0],
    [-1, 4, -1],
    [0, -1, 0]
]

for y in range(1, tinggi - 1):
    for x in range(1, lebar - 1):
        total = 0

        for i in range(-1, 2):
            for j in range(-1, 2):
                total += int(img[y + i, x + j]) * kernel_lap[i + 1][j + 1]

        laplacian[y, x] = min(255, max(0, total))


# 5. Menampilkan hasil
images = [
    img,
    mean_filter,
    median_filter,
    gaussian_filter,
    laplacian
]

titles = [
    'Original Image',
    'Mean Filter',
    'Median Filter',
    'Gaussian Filter',
    'Laplacian Filter'
]

plt.figure(figsize=(12, 8))

for i in range(len(images)):
    plt.subplot(2, 3, i + 1)
    plt.imshow(images[i], cmap='gray')
    plt.title(titles[i])
    plt.axis('off')

plt.tight_layout()
plt.show()
